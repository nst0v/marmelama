---
import BaseLayout from '../layouts/BaseLayout.astro';
import { kittens } from '../data/kittens';
import { parents } from '../data/parents';

const base = import.meta.env.BASE_URL;
const asset = (src: string) => `${base}${src.replace(/^\//, '')}`;
const images = [...kittens.flatMap((kitten) => kitten.images), ...parents.flatMap((parent) => parent.images)].slice(0, 18);
---

<BaseLayout title="Галерея - МарМелАма" description="Фотогалерея котят и производителей питомника МарМелАма.">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Галерея</p>
      <h1>Галерея</h1>
      <p class="lead">Фотографии котят и производителей питомника.</p>
    </div>
  </section>
  <section class="section">
    <div class="container gallery-grid">
      {images.map((image) => <img src={asset(image)} alt="Фото питомника МарМелАма" loading="lazy" />)}
    </div>
  </section>
</BaseLayout>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .gallery-grid img {
    width: 100%;
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    object-fit: cover;
    background: var(--color-soft);
  }

  @media (max-width: 760px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
