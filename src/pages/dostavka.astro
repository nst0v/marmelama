---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CTASection from '../components/CTASection.astro';
import { site } from '../data/site';

const items = [
  ['Авиа', 'Подберем подходящий маршрут и обсудим условия перевозки.'],
  ['Ж/Д', 'Организуем отправку через железнодорожных перевозчиков, когда это удобно по направлению.'],
  ['Курьерские службы', 'Используем проверенные варианты доставки и заранее согласуем детали.'],
  ['Самовывоз', 'Если вы рядом, можно обсудить личную встречу и передачу котенка.'],
  ['Подготовка к переезду', 'Расскажем, что подготовить дома: корм, лоток, когтеточку и спокойное место.'],
  ['Стоимость доставки', 'Стоимость зависит от города, маршрута и способа перевозки - ее лучше уточнить напрямую.']
];
---

<BaseLayout title="Доставка котят - МарМелАма" description="Доставка котят бурмы по России и за ее пределами: авиа, ж/д перевозчики и проверенные курьерские службы.">
  <section class="page-hero">
    <div class="container split">
      <div>
        <p class="eyebrow">Доставка</p>
        <h1>Доставка котят</h1>
        <p class="lead">Организуем доставку котят по России и за ее пределами.</p>
      </div>
      <div class="button-row">
        <Button href={site.max}>Уточнить доставку в MAX</Button>
        <Button href="/contacts" variant="secondary">Оставить заявку</Button>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container grid grid-3">
      {items.map(([title, text]) => (
        <article class="delivery-card">
          <h2>{title}</h2>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>
  <CTASection title="Написать в MAX и уточнить доставку" text="Расскажите город и желаемого котенка - мы подскажем возможные варианты." />
</BaseLayout>

<style>
  .delivery-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 24px;
    background: var(--color-surface);
  }

  .delivery-card h2 {
    font-family: var(--font-body);
    font-size: 22px;
  }

  .delivery-card p {
    margin-top: 10px;
    color: var(--color-muted);
  }
</style>
