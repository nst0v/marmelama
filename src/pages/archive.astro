---
import BaseLayout from '../layouts/BaseLayout.astro';
import LitterCard from '../components/LitterCard.astro';
import CTASection from '../components/CTASection.astro';
import { litters } from '../data/litters';
---

<BaseLayout title="Архив котят и пометов - МарМелАма" description="Архивные пометы питомника МарМелАма.">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Архив</p>
      <h1>Предыдущие пометы</h1>
      <p class="lead">История пометов питомника. Актуальных котят смотрите в разделе продажи.</p>
    </div>
  </section>
  <section class="section">
    <div class="container grid grid-3">
      {litters.filter((litter) => litter.status === 'archive').map((litter) => <LitterCard litter={litter} />)}
    </div>
  </section>
  <CTASection title="Хотите узнать об актуальных котятах?" text="Напишите нам - подскажем, кто сейчас доступен для бронирования." />
</BaseLayout>
