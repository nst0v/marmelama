---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ParentCard from '../../../components/ParentCard.astro';
import CTASection from '../../../components/CTASection.astro';
import { maleParents } from '../../../data/parents';
---

<BaseLayout title="Наши коты - производители МарМелАма" description="Коты-производители питомника европейской бурмы МарМелАма.">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Производители</p>
      <h1>Наши коты</h1>
      <p class="lead">Коты питомника МарМелАма, участвующие в племенной работе.</p>
    </div>
  </section>
  <section class="section">
    <div class="container grid grid-3">
      {maleParents.map((parent) => <ParentCard parent={parent} />)}
    </div>
  </section>
  <CTASection title="Посмотреть котят от производителей" text="Перейдите в каталог или напишите нам, чтобы узнать о текущих пометах." />
</BaseLayout>
