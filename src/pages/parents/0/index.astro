---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ParentCard from '../../../components/ParentCard.astro';
import CTASection from '../../../components/CTASection.astro';
import { femaleParents, formerParents } from '../../../data/parents';
---

<BaseLayout title="Наши кошки - производители МарМелАма" description="Кошки питомника европейской бурмы МарМелАма.">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Производители</p>
      <h1>Наши кошки</h1>
      <p class="lead">Кошки питомника МарМелАма и бывшие производители.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        {femaleParents.map((parent) => <ParentCard parent={parent} />)}
      </div>
    </div>
  </section>
  <section class="section section--soft">
    <div class="container">
      <h2>Бывшие производители</h2>
      <div class="grid grid-3 former">
        {formerParents.map((parent) => <ParentCard parent={parent} />)}
      </div>
    </div>
  </section>
  <CTASection />
</BaseLayout>

<style>
  .former {
    margin-top: 28px;
  }
</style>
