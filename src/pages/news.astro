---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
---

<BaseLayout title="Новости - МарМелАма" description="Новости питомника МарМелАма.">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Новости</p>
      <h1>Новости</h1>
      <p class="lead">Раздел подготовлен для будущих публикаций питомника.</p>
    </div>
  </section>
  <section class="section">
    <div class="container card empty-page">
      <h2>Скоро здесь появятся новости</h2>
      <p>Пока актуальную информацию о котятах удобнее смотреть в каталоге или уточнять напрямую.</p>
    </div>
  </section>
  <CTASection />
</BaseLayout>

<style>
  .empty-page {
    padding: 28px;
  }

  .empty-page p {
    margin-top: 10px;
    color: var(--color-muted);
  }
</style>
