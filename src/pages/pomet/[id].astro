---
import BaseLayout from '../../layouts/BaseLayout.astro';
import KittenCard from '../../components/KittenCard.astro';
import ParentCard from '../../components/ParentCard.astro';
import CTASection from '../../components/CTASection.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getLitterById, litters } from '../../data/litters';
import { kittens } from '../../data/kittens';
import { parents } from '../../data/parents';

export function getStaticPaths() {
  return litters.map((litter) => ({ params: { id: litter.id } }));
}

const litter = getLitterById(Astro.params.id ?? '')!;
const litterKittens = kittens.filter((kitten) => litter.kittenIds?.includes(kitten.id));
const litterParents = parents.filter((parent) => litter.parentIds?.includes(parent.id));
---

<BaseLayout title={`${litter.title} - помет МарМелАма`} description={`${litter.title}: дата рождения, котята и информация о помете питомника МарМелАма.`}>
  <section class="page-hero">
    <div class="container litter-hero">
      <div>
        <p class="eyebrow">Помет {litter.letter}</p>
        <h1>{litter.title}</h1>
        <p class="lead">Дата рождения: {litter.date}</p>
      </div>
      <div class="litter-summary card">
        <StatusBadge status={litter.status} />
        <div class="meta-list">
          <div class="meta-item"><span>Мальчики</span><span>{litter.boys ?? '—'}</span></div>
          <div class="meta-item"><span>Девочки</span><span>{litter.girls ?? '—'}</span></div>
        </div>
      </div>
    </div>
  </section>

  {litterParents.length > 0 && (
    <section class="section">
      <div class="container">
        <h2>Родители</h2>
        <div class="grid grid-3 cards-offset">
          {litterParents.map((parent) => <ParentCard parent={parent} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section section--soft">
    <div class="container">
      <h2>Котята помета</h2>
      {litterKittens.length > 0 ? (
        <div class="grid grid-3 cards-offset">
          {litterKittens.map((kitten) => <KittenCard kitten={kitten} />)}
        </div>
      ) : (
        <p class="lead cards-offset">Подробные карточки котят этого помета будут добавлены после обновления данных.</p>
      )}
    </div>
  </section>

  <CTASection />
</BaseLayout>

<style>
  .litter-hero {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 28px;
    align-items: center;
  }

  .litter-summary {
    display: grid;
    gap: 18px;
    padding: 24px;
  }

  .cards-offset {
    margin-top: 28px;
  }

  @media (max-width: 780px) {
    .litter-hero {
      grid-template-columns: 1fr;
    }
  }
</style>
