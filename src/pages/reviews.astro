---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReviewCard from '../components/ReviewCard.astro';
import ContactForm from '../components/ContactForm.astro';
import CTASection from '../components/CTASection.astro';
import { reviews } from '../data/reviews';
---

<BaseLayout title="Отзывы - питомник МарМелАма" description="Отзывы владельцев котят питомника МарМелАма.">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Отзывы</p>
      <h1>Отзывы владельцев</h1>
      <p class="lead">Истории семей, к которым переехали выпускники питомника МарМелАма.</p>
    </div>
  </section>
  <section class="section">
    <div class="container grid grid-3">
      {reviews.map((review) => <ReviewCard review={review} />)}
    </div>
  </section>
  <section class="section section--soft">
    <div class="container split">
      <div>
        <h2>Хотите оставить отзыв или задать вопрос?</h2>
        <p class="lead">Заполните форму, и письмо откроется в вашей почтовой программе.</p>
      </div>
      <ContactForm title="Добавить отзыв" />
    </div>
  </section>
  <CTASection />
</BaseLayout>
