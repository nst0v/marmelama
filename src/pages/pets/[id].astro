---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import Gallery from '../../components/Gallery.astro';
import KittenCard from '../../components/KittenCard.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import CTASection from '../../components/CTASection.astro';
import { getKittenById, kittens } from '../../data/kittens';
import { getLitterById } from '../../data/litters';
import { site } from '../../data/site';

export function getStaticPaths() {
  return kittens.map((kitten) => ({ params: { id: kitten.id } }));
}

const kitten = getKittenById(Astro.params.id ?? '');
if (!kitten) {
  return Astro.redirect('/pets');
}

const litter = kitten.litterId ? getLitterById(kitten.litterId) : undefined;
const gender = kitten.gender === 'male' ? 'Мальчик' : kitten.gender === 'female' ? 'Девочка' : undefined;
const otherKittens = kittens.filter((item) => item.id !== kitten.id && item.status === 'available').slice(0, 3);
---

<BaseLayout title={`${kitten.name} - бурманский котенок МарМелАма`} description={`${kitten.name}: бурманский котенок питомника МарМелАма. Фото, статус, окрас, помет и связь для бронирования.`}>
  <section class="page-hero">
    <div class="container kitten-detail">
      <Gallery images={kitten.images} alt={`Бурманский котенок ${kitten.name}`} />
      <div class="detail-panel card">
        <p class="eyebrow">Котенок</p>
        <h1>{kitten.name}</h1>
        <StatusBadge status={kitten.status} />
        <div class="meta-list">
          {gender && <div class="meta-item"><span>Пол</span><span>{gender}</span></div>}
          {kitten.color && <div class="meta-item"><span>Окрас</span><span>{kitten.color}</span></div>}
          {kitten.birthDate && <div class="meta-item"><span>Дата рождения</span><span>{kitten.birthDate}</span></div>}
          {litter && <div class="meta-item"><span>Помет</span><span>{litter.title}</span></div>}
        </div>
        <div class="button-row">
          <Button href="/contacts">Узнать цену</Button>
          <Button href={site.max} variant="secondary">Забронировать в MAX</Button>
        </div>
      </div>
    </div>
  </section>

  {kitten.description && (
    <section class="section">
      <div class="container split">
        <div>
          <p class="eyebrow">О котенке</p>
          <h2>{kitten.name}</h2>
        </div>
        <div class="prose">
          <p>{kitten.description}</p>
        </div>
      </div>
    </section>
  )}

  <section class="section section--soft">
    <div class="container">
      <div class="grid grid-3">
        <article class="info-card">
          <h3>Что входит при передаче</h3>
          <p>Консультация по уходу, рекомендации по адаптации и помощь с доставкой.</p>
        </article>
        <article class="info-card">
          <h3>Доставка</h3>
          <p>Организуем доставку авиа, ж/д перевозчиками и проверенными курьерскими службами.</p>
        </article>
        <article class="info-card">
          <h3>Связь</h3>
          <p>Можно написать в MAX или оставить заявку - расскажем подробности и ответим на вопросы.</p>
        </article>
      </div>
    </div>
  </section>

  {otherKittens.length > 0 && (
    <section class="section">
      <div class="container">
        <h2>Другие свободные котята</h2>
        <div class="grid grid-3 related">
          {otherKittens.map((item) => <KittenCard kitten={item} compact />)}
        </div>
      </div>
    </section>
  )}

  <CTASection />
</BaseLayout>

<style>
  .kitten-detail {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.72fr);
    gap: 34px;
    align-items: start;
  }

  .detail-panel {
    position: sticky;
    top: 106px;
    display: grid;
    gap: 18px;
    padding: 26px;
  }

  .info-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 24px;
    background: var(--color-surface);
  }

  .info-card p {
    margin-top: 10px;
    color: var(--color-muted);
  }

  .related {
    margin-top: 28px;
  }

  @media (max-width: 900px) {
    .kitten-detail {
      grid-template-columns: 1fr;
    }

    .detail-panel {
      position: static;
    }
  }
</style>
