---
import type { KittenStatus } from '../data/types';

interface Props {
  status: KittenStatus | 'active' | 'archive';
}

const { status } = Astro.props;
const labels = {
  available: 'Свободен',
  reserved: 'Бронь',
  sold: 'Переехал',
  active: 'Есть котята',
  archive: 'Архив'
};

const className = status === 'active' ? 'available' : status === 'archive' ? 'sold' : status;
---

<span class={`status ${className}`}>{labels[status]}</span>
