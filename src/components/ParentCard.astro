---
import type { Parent } from '../data/types';
import Button from './Button.astro';

interface Props {
  parent: Parent;
}

const { parent } = Astro.props;
const base = import.meta.env.BASE_URL;
const asset = (src: string) => src.startsWith('http') ? src : `${base}${src.replace(/^\//, '')}`;
const typePath = parent.type === 'male' ? '1' : '0';
---

<article class="parent-card card">
  <a class="parent-photo" href={`${base}parents/${typePath}/${parent.id}`}>
    <img src={asset(parent.images[0])} alt={`${parent.name}, производитель питомника МарМелАма`} loading="lazy" />
  </a>
  <div class="parent-body">
    <div>
      <p class="eyebrow">{parent.type === 'male' ? 'Кот' : parent.former ? 'Бывший производитель' : 'Кошка'}</p>
      <h3>{parent.name}</h3>
      <p class="muted">{[parent.title, parent.color].filter(Boolean).join(' · ')}</p>
    </div>
    {parent.tests && <p class="tests">{parent.tests}</p>}
    <Button href={`/parents/${typePath}/${parent.id}`} variant="secondary">Подробнее</Button>
  </div>
</article>

<style>
  .parent-card {
    overflow: hidden;
  }

  .parent-photo {
    display: block;
    aspect-ratio: 4 / 3;
    background: var(--color-soft);
  }

  .parent-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .parent-body {
    display: grid;
    gap: 16px;
    padding: 20px;
  }

  .tests {
    color: var(--color-muted);
    font-size: 14px;
  }
</style>
