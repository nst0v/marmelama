---
import { site } from '../data/site';
import Button from './Button.astro';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Хотите подобрать бурманского котенка?',
  text = 'Напишите нам - расскажем, кто сейчас свободен, и поможем выбрать малыша для вашей семьи.'
} = Astro.props;
---

<section class="section">
  <div class="container cta card">
    <div>
      <p class="eyebrow">Консультация</p>
      <h2>{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="button-row">
      <Button href={site.max}>Написать в MAX</Button>
      <Button href="/contacts" variant="secondary">Заказать звонок</Button>
    </div>
  </div>
</section>

<style>
  .cta {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    align-items: center;
    padding: 34px;
    background: linear-gradient(135deg, #fff, var(--color-soft));
  }

  .lead {
    margin-top: 12px;
  }

  @media (max-width: 760px) {
    .cta {
      display: grid;
      padding: 24px;
    }
  }
</style>
