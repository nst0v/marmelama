---
import { nav, site } from '../data/site';
import Button from './Button.astro';

const base = import.meta.env.BASE_URL;
const link = (href: string) => `${base}${href.replace(/^\//, '')}`;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={link('/')}>
      <span class="brand-name">{site.name}</span>
      <span class="brand-tagline">{site.tagline}</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu">
      <span>Меню</span>
    </button>

    <nav class="main-nav" id="site-menu" aria-label="Основная навигация">
      {nav.map((item) => <a href={link(item.href)}>{item.label}</a>)}
    </nav>

    <div class="header-actions">
      <a class="phone-link" href={site.phoneHref}>{site.phone}</a>
      <Button href={site.whatsapp} variant="secondary">WhatsApp</Button>
      <Button href="/contacts">Забронировать</Button>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('.main-nav');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    nav?.classList.toggle('is-open', !isOpen);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid rgba(232, 221, 211, 0.84);
    background: rgba(250, 247, 242, 0.92);
    backdrop-filter: blur(14px);
  }

  .header-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 22px;
    align-items: center;
    min-height: 82px;
  }

  .brand {
    display: grid;
    gap: 1px;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 700;
    line-height: 1;
  }

  .brand-tagline {
    color: var(--color-muted);
    font-size: 13px;
  }

  .main-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px;
  }

  .main-nav a {
    border-radius: 999px;
    padding: 8px 10px;
    color: var(--color-muted);
    font-size: 14px;
    font-weight: 800;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .main-nav a:hover {
    background: var(--color-soft);
    color: var(--color-primary-dark);
    transform: translateY(-1px);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .phone-link {
    white-space: nowrap;
    font-size: 14px;
    font-weight: 800;
  }

  .menu-toggle {
    display: none;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 10px 14px;
    background: var(--color-surface);
    color: var(--color-text);
    font-weight: 800;
  }

  @media (max-width: 1100px) {
    .header-inner {
      grid-template-columns: auto auto;
      justify-content: space-between;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .main-nav,
    .header-actions {
      grid-column: 1 / -1;
    }

    .main-nav {
      justify-content: flex-start;
      border: 1px solid var(--color-border);
      border-radius: 24px;
      max-height: 0;
      overflow: hidden;
      border-color: transparent;
      padding: 0 12px;
      background: var(--color-surface);
      opacity: 0;
      pointer-events: none;
      transform: translateY(-8px);
      transition: max-height 0.28s ease, opacity 0.22s ease, padding 0.28s ease, border-color 0.22s ease, transform 0.28s ease;
    }

    .main-nav.is-open {
      max-height: 420px;
      border-color: var(--color-border);
      padding: 12px;
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }
  }

  @media (max-width: 700px) {
    .header-inner {
      min-height: 70px;
      gap: 12px;
    }

    .brand-name {
      font-size: 25px;
    }

    .brand-tagline {
      font-size: 12px;
    }

    .header-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .phone-link {
      grid-column: 1 / -1;
    }
  }
</style>
