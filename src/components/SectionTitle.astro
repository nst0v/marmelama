---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  center?: boolean;
}

const { eyebrow, title, text, center = false } = Astro.props;
---

<div class:list={['section-title', { center }]}>
  {eyebrow && <div class="eyebrow">{eyebrow}</div>}
  <h2>{title}</h2>
  {text && <p class="lead">{text}</p>}
</div>
