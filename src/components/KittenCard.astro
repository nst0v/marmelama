---
import type { Kitten } from '../data/types';
import { getLitterById } from '../data/litters';
import Button from './Button.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  kitten: Kitten;
  compact?: boolean;
}

const { kitten, compact = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const asset = (src: string) => src.startsWith('http') ? src : `${base}${src.replace(/^\//, '')}`;
const litter = kitten.litterId ? getLitterById(kitten.litterId) : undefined;
const gender = kitten.gender === 'male' ? 'Мальчик' : kitten.gender === 'female' ? 'Девочка' : undefined;
---

<article class="kitten-card card">
  <a class="kitten-photo" href={`${base}pets/${kitten.slug}`} aria-label={`Подробнее о котенке ${kitten.name}`}>
    <img src={asset(kitten.images[0])} alt={`Бурманский котенок ${kitten.name}`} loading="lazy" />
    <StatusBadge status={kitten.status} />
  </a>
  <div class="kitten-body">
    <div>
      <h3>{kitten.name}</h3>
      {kitten.description && !compact && <p>{kitten.description}</p>}
    </div>
    <dl>
      {gender && <div><dt>Пол</dt><dd>{gender}</dd></div>}
      {kitten.color && <div><dt>Окрас</dt><dd>{kitten.color}</dd></div>}
      {litter && <div><dt>Помет</dt><dd>{litter.letter}</dd></div>}
      {kitten.birthDate && <div><dt>Дата рождения</dt><dd>{kitten.birthDate}</dd></div>}
    </dl>
    <div class="button-row">
      <Button href={`/pets/${kitten.slug}`} variant="secondary">Подробнее</Button>
      <Button href="/contacts">Узнать цену</Button>
    </div>
  </div>
</article>

<style>
  .kitten-card {
    overflow: hidden;
  }

  .kitten-photo {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    background: var(--color-soft);
  }

  .kitten-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .kitten-photo :global(.status) {
    position: absolute;
    top: 14px;
    left: 14px;
  }

  .kitten-body {
    display: grid;
    gap: 18px;
    padding: 20px;
  }

  h3 {
    margin-bottom: 5px;
  }

  p {
    color: var(--color-muted);
  }

  dl {
    display: grid;
    gap: 8px;
    margin: 0;
  }

  dl div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 8px;
  }

  dt {
    color: var(--color-muted);
  }

  dd {
    margin: 0;
    font-weight: 800;
    text-align: right;
  }
</style>
