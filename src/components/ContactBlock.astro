---
import { site } from '../data/site';
import Button from './Button.astro';
---

<div class="contact-block card">
  <h3>Связаться с питомником</h3>
  <p class="muted">Напишите нам, если хотите узнать о свободных котятах, цене, бронировании или доставке.</p>
  <div class="contact-links">
    <a href={site.phoneHref}>{site.phone}</a>
    <a href={site.whatsapp}>WhatsApp</a>
    <a href={site.emailHref}>{site.email}</a>
    <a href={site.vk}>ВКонтакте</a>
  </div>
  <div class="button-row">
    <Button href={site.whatsapp}>Написать в WhatsApp</Button>
    <Button href={site.phoneHref} variant="secondary">Позвонить</Button>
  </div>
</div>

<style>
  .contact-block {
    display: grid;
    gap: 18px;
    padding: 24px;
  }

  .contact-links {
    display: grid;
    gap: 9px;
  }

  .contact-links a {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 9px;
    font-weight: 800;
  }
</style>
