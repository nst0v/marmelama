---
import { nav, site } from '../data/site';
import Button from './Button.astro';

const base = import.meta.env.BASE_URL;
const link = (href: string) => `${base}${href.replace(/^\//, '')}`;
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="brand-name">{site.name}</div>
      <p>{site.tagline}. Помогаем выбрать бурманского котенка и остаемся на связи после переезда.</p>
      <Button href={site.max}>Написать в MAX</Button>
      <div class="social-links" aria-label="Социальные сети">
        <a href={site.instagram} aria-label="Instagram МарМелАма">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.4" cy="6.6" r="1.2"></circle>
          </svg>
        </a>
        <a href={site.vk} aria-label="ВКонтакте МарМелАма">
          <span>VK</span>
        </a>
        <a href={site.max} aria-label="MAX МарМелАма">
          <span>MAX</span>
        </a>
      </div>
    </div>
    <div>
      <h2>Навигация</h2>
      <ul>
        {nav.slice(0, 6).map((item) => <li><a href={link(item.href)}>{item.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h2>Покупателям</h2>
      <ul>
        <li><a href={link('/pets')}>Как выбрать котенка</a></li>
        <li><a href={link('/dostavka')}>Доставка</a></li>
        <li><a href={link('/archive')}>Архив котят</a></li>
        <li><a href={link('/reviews')}>Отзывы владельцев</a></li>
      </ul>
    </div>
    <div>
      <h2>Контакты</h2>
      <ul>
        <li><a href={site.phoneHref}>{site.phone}</a></li>
        <li><a href={site.max}>MAX: {site.phone}</a></li>
        <li><a href={site.emailHref}>{site.email}</a></li>
        <li><a href={site.vk}>ВКонтакте</a></li>
        <li><a href={site.instagram}>Instagram</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>{site.copyright} © 2024-2026</span>
    <a href={link('/politics')}>Политика конфиденциальности</a>
  </div>
</footer>

<style>
  .site-footer {
    padding: 58px 0 28px;
    background: var(--color-text);
    color: #fff;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: 34px;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 700;
  }

  .footer-brand {
    display: grid;
    justify-items: start;
    gap: 18px;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .social-links a {
    display: inline-flex;
    width: 42px;
    height: 42px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 50%;
    color: #fff;
    font-size: 12px;
    font-weight: 900;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .social-links a:hover {
    border-color: rgba(255, 255, 255, 0.42);
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-1px);
  }

  .social-links svg {
    width: 21px;
    height: 21px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .site-footer p,
  .site-footer a,
  .footer-bottom {
    color: rgba(255, 255, 255, 0.72);
  }

  .site-footer h2 {
    margin-bottom: 14px;
    color: #fff;
    font-family: var(--font-body);
    font-size: 16px;
  }

  ul {
    display: grid;
    gap: 9px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a:hover {
    color: #fff;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    margin-top: 42px;
    padding-top: 22px;
    font-size: 14px;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .footer-grid,
    .footer-bottom {
      display: grid;
      grid-template-columns: 1fr;
    }
  }
</style>
