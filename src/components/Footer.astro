---
import { nav, site } from '../data/site';
import Button from './Button.astro';

const base = import.meta.env.BASE_URL;
const link = (href: string) => `${base}${href.replace(/^\//, '')}`;
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="brand-name">{site.name}</div>
      <p>{site.tagline}. Помогаем выбрать бурманского котенка и остаемся на связи после переезда.</p>
      <Button href={site.whatsapp}>Написать в WhatsApp</Button>
    </div>
    <div>
      <h2>Навигация</h2>
      <ul>
        {nav.slice(0, 6).map((item) => <li><a href={link(item.href)}>{item.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h2>Покупателям</h2>
      <ul>
        <li><a href={link('/pets')}>Как выбрать котенка</a></li>
        <li><a href={link('/dostavka')}>Доставка</a></li>
        <li><a href={link('/archive')}>Архив котят</a></li>
        <li><a href={link('/reviews')}>Отзывы владельцев</a></li>
      </ul>
    </div>
    <div>
      <h2>Контакты</h2>
      <ul>
        <li><a href={site.phoneHref}>{site.phone}</a></li>
        <li><a href={site.whatsapp}>WhatsApp</a></li>
        <li><a href={site.emailHref}>{site.email}</a></li>
        <li><a href={site.vk}>ВКонтакте</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>{site.copyright} © 2024-2026</span>
    <a href={link('/politics')}>Политика конфиденциальности</a>
  </div>
</footer>

<style>
  .site-footer {
    padding: 58px 0 28px;
    background: var(--color-text);
    color: #fff;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: 34px;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 700;
  }

  .footer-brand {
    display: grid;
    justify-items: start;
    gap: 18px;
  }

  .site-footer p,
  .site-footer a,
  .footer-bottom {
    color: rgba(255, 255, 255, 0.72);
  }

  .site-footer h2 {
    margin-bottom: 14px;
    color: #fff;
    font-family: var(--font-body);
    font-size: 16px;
  }

  ul {
    display: grid;
    gap: 9px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a:hover {
    color: #fff;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    margin-top: 42px;
    padding-top: 22px;
    font-size: 14px;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .footer-grid,
    .footer-bottom {
      display: grid;
      grid-template-columns: 1fr;
    }
  }
</style>
