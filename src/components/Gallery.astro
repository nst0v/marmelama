---
interface Props {
  images: string[];
  alt: string;
}

const { images, alt } = Astro.props;
const base = import.meta.env.BASE_URL;
const asset = (src: string) => src.startsWith('http') ? src : `${base}${src.replace(/^\//, '')}`;
---

<div class="gallery">
  <img class="main-image" src={asset(images[0])} alt={alt} />
  {images.length > 1 && (
    <div class="thumbs">
      {images.slice(1, 5).map((image) => <img src={asset(image)} alt={alt} loading="lazy" />)}
    </div>
  )}
</div>

<style>
  .gallery {
    display: grid;
    gap: 12px;
  }

  .main-image,
  .thumbs img {
    width: 100%;
    object-fit: cover;
    border-radius: var(--radius-lg);
    background: var(--color-soft);
  }

  .main-image {
    aspect-ratio: 4 / 3;
  }

  .thumbs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .thumbs img {
    aspect-ratio: 1;
    border-radius: 16px;
  }
</style>
