---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  full?: boolean;
  label?: string;
}

const { href, variant = 'primary', full = false, label } = Astro.props;
const base = import.meta.env.BASE_URL;
const isExternal = href.startsWith('http') || href.startsWith('tel:') || href.startsWith('mailto:');
const isHash = href.startsWith('#');
const resolvedHref = isExternal || isHash ? href : `${base}${href.replace(/^\//, '')}`;
const classes = ['button', variant !== 'primary' ? variant : '', full ? 'full' : ''].filter(Boolean).join(' ');
---

<a class={classes} href={resolvedHref} aria-label={label}>
  <slot />
</a>
